HUBSPOT_ACCESS_TOKEN=       # HubSpot private app token
SUPABASE_URL=               # Supabase project URL
SUPABASE_SERVICE_KEY=       # Supabase service role key
RESEND_API_KEY=             # Resend API key
WEBFLOW_WEBHOOK_SECRET=     # (optional) Webflow webhook signing secret
ANTHROPIC_API_KEY=          # (optional) Anthropic API key for AI-personalized lead summaries
QUO_API_KEY=                # Quo (OpenPhone) API key for expert SMS alerts
QUO_FROM_NUMBER=            # Quo phone number to send from (default: +12122887892)
PORT=3000
